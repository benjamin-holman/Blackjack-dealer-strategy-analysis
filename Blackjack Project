        "#monte carlo simulation for part 1\n",
        "def simulate(threshold=17, N=1000000):\n",
        "    counts = Counter()\n",
        "    for _ in range(N):\n",
        "        cards, total = dealer_hand(threshold)\n",
        "        if total > 21:\n",
        "            counts['bust'] += 1\n",
        "        elif total == 21 and len(cards) == 2:\n",
        "            counts['blackjack'] += 1\n",
        "        else:\n",
