        "#part 2\n",
        "#house edge when the player copies the dealer (exact)\n",
        "\n",
        "def payoff(player, dealer):\n",
        "    if player == 'blackjack' and dealer == 'blackjack': return 0\n",
        "    if player == 'blackjack': return 1.5\n",
        "    if dealer == 'blackjack': return -1\n",
        "    if player == 'bust':      return -1   # player busts first, loses regardless\n",
        "    if dealer == 'bust':      return 1\n",
        "    return (player > dealer) - (player < dealer)   # +1 win, -1 loss, 0 push\n",
        "\n",
        "def house_edge(player_threshold, dealer_threshold=17):\n",
        "    P = final_dist(player_threshold)\n",
        "    D = final_dist(dealer_threshold)\n",
        "    return -sum(pp * pd * payoff(p, d)\n",
        "                for p, pp in P.items()\n",
        "                for d, pd in D.items())\n",
        "\n",
        "thresholds = range(15, 21)\n",
        "table2 = pd.DataFrame(\n",
        "    {'House edge (%)': [round(house_edge(t, t) * 100, 2) for t in thresholds]},\n",
        "    index=[f'Both stand on {t}' for t in thresholds]\n",
        ")\n",
        "\n",
        "print(table2)"
