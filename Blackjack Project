        "# Part 1: dealer final-total distribution for different standing thresholds\n",
        "\n",
        "def final_dist(threshold):\n",
        "\n",
        "    @lru_cache(maxsize=None)\n",
        "    def dist(total, soft):\n",
        "        if total > 21:\n",
        "            return {'bust': 1.0}\n",
        "        if total >= threshold:\n",
        "            return {total: 1.0}\n",
        "        out = defaultdict(float)\n",
        "        for card, p in CARD_PROBS.items():\n",
        "            t, s = add_card(total, soft, card)\n",
        "            for outcome, q in dist(t, s).items():\n",
        "                out[outcome] += p * q\n",
        "        return dict(out)\n",
        "\n",
        "    result = defaultdict(float)\n",
        "    for c1, p1 in CARD_PROBS.items():\n",
        "        for c2, p2 in CARD_PROBS.items():\n",
        "            t, s = add_card(0, 0, c1)\n",
        "            t, s = add_card(t, s, c2)\n",
        "            if t == 21:\n",
        "                result['blackjack'] += p1 * p2\n",
        "            else:\n",
        "                for outcome, q in dist(t, s).items():\n",
        "                    result[outcome] += p1 * p2 * q\n",
        "    return dict(result)\n",
        "\n",
        "outcomes = [15, 16, 17, 18, 19, 20, 21, 'blackjack', 'bust']\n",
        "dists = {t: final_dist(t) for t in range(15, 21)}\n",
        "\n",
        "table1 = pd.DataFrame(\n",
        "    {f'Stand {t}': [dists[t].get(o, 0) * 100 for o in outcomes] for t in range(15, 21)},\n",
        "    index=['15', '16', '17', '18', '19', '20', '21', 'Blackjack', 'Bust']\n",
        ").round(2)\n",
        "\n",
        "print(table1.replace(0.0, '–'))"
