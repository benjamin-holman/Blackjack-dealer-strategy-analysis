        "# Part 4: basic strategy against a dealer standing on 17\n",
        "\n",
        "@lru_cache(maxsize=None)\n",
        "def dealer_from(total, soft, n_cards):\n",
        "    if total > 21:\n",
        "        return {'bust': 1.0}\n",
        "    if total >= 17:\n",
        "        if total == 21 and n_cards == 2:\n",
        "            return {'blackjack': 1.0}\n",
        "        return {total: 1.0}\n",
        "    dist = {}\n",
        "    for card, pc in CARD_PROBS.items():\n",
        "        t, s = add_card(total, soft, card)\n",
        "        for result, pr in dealer_from(t, s, n_cards + 1).items():\n",
        "            dist[result] = dist.get(result, 0) + pc * pr\n",
        "    return dist\n",
        "\n",
        "@lru_cache(maxsize=None)\n",
        "def dealer_dist(upcard):\n",
        "    total, soft = add_card(0, 0, upcard)\n",
        "    full = dealer_from(total, soft, 1)\n",
        "    p_bj = full.get('blackjack', 0)\n",
        "    cond = {k: v / (1 - p_bj) for k, v in full.items() if k != 'blackjack'}\n",
        "    return cond, p_bj\n",
        "\n",
        "#players expected value\n",
        "def ev_stand(total, upcard):\n",
        "    if total > 21:\n",
        "        return -1.0\n",
        "    dist, _ = dealer_dist(upcard)\n",
        "    ev = 0.0\n",
        "    for result, p in dist.items():\n",
        "        if result == 'bust' or result < total:\n",
        "            ev += p\n",
        "        elif result > total:\n",
        "            ev -= p\n",
        "    return ev\n",
        "\n",
        "@lru_cache(maxsize=None)\n",
        "def ev_hit(total, soft, upcard):\n",
        "    ev = 0.0\n",
        "    for card, pc in CARD_PROBS.items():\n",
        "        t, s = add_card(total, soft, card)\n",
        "        ev += -pc if t > 21 else pc * best_ev(t, s, upcard)\n",
        "    return ev\n",
        "\n",
        "@lru_cache(maxsize=None)\n",
        "def best_ev(total, soft, upcard):\n",
        "    return max(ev_stand(total, upcard), ev_hit(total, soft, upcard))\n",
        "\n",
        "def best_action(total, soft, upcard):\n",
        "    return 'S' if ev_stand(total, upcard) >= ev_hit(total, soft, upcard) else 'H'\n",
        "\n",
        "#table\n",
        "upcard_labels = ['A' if u == 11 else str(u) for u in RANKS]\n",
        "\n",
        "hard_table = pd.DataFrame(\n",
        "    [[best_action(t, 0, u) for u in RANKS] for t in range(5, 21)],\n",
        "    index=range(5, 21), columns=upcard_labels)\n",
        "hard_table.index.name = 'Hard total'\n",
        "\n",
        "soft_table = pd.DataFrame(\n",
        "    [[best_action(t, 1, u) for u in RANKS] for t in range(13, 21)],\n",
        "    index=[f'A{t-11}' for t in range(13, 21)], columns=upcard_labels)\n",
        "soft_table.index.name = 'Soft hand'\n",
        "\n",
        "print(hard_table, '\\n')\n",
        "print(soft_table)\n",
        "\n",
        "\n",
        "#house edge\n",
        "def basic_strategy_house_edge():\n",
        "    ev = 0.0\n",
        "    for c1, p1 in CARD_PROBS.items():\n",
        "        for c2, p2 in CARD_PROBS.items():\n",
        "            t, s = add_card(*add_card(0, 0, c1), c2)\n",
        "            for u, pu in CARD_PROBS.items():\n",
        "                p = p1 * p2 * pu\n",
        "                _, p_bj = dealer_dist(u)\n",
        "                if t == 21:\n",
        "                    ev += p * (1 - p_bj) * 1.5\n",
        "                else:\n",
        "                    ev += p * (-p_bj + (1 - p_bj) * best_ev(t, s, u))\n",
        "    return -ev\n",
        "\n",
        "print(f\"\\nHouse edge: {basic_strategy_house_edge()*100:.2f}%\")"
